APP_NAME="Care& Backend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Seoul

LOG_CHANNEL=stack
LOG_LEVEL=debug

# === Database (MariaDB) ===
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=careand
DB_USERNAME=careand
DB_PASSWORD=

# === Redis ===
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
FILESYSTEM_DISK=s3

# === JWT ===
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# === AWS S3 ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2
AWS_BUCKET=careand-media

# === FCM ===
FCM_SERVER_KEY=

# === 외부 시스템 ===
MOHW_API_URL=https://www.mohw.go.kr/api
MOHW_API_KEY=
NHIS_API_URL=https://www.nhis.or.kr/ltc/api
NHIS_API_KEY=
PG_PROVIDER=kg_inicis
PG_MID=
PG_API_KEY=
HOMETAX_API_URL=https://www.hometax.go.kr/api
HOMETAX_API_KEY=

# === AI 마이크로서비스 ===
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TOKEN=

# === SMS (OTP) ===
SMS_PROVIDER=aligo
SMS_API_KEY=
SMS_USER_ID=
SMS_SENDER=
