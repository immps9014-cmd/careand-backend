# /root 는 캐시·비밀·중첩 git 리포·무관 프로젝트가 뒤섞인 홈 디렉터리다.
# 안전을 위해 "전부 무시" 후 큐레이션한 설정/문서/스크립트만 화이트리스트한다.
# (자격증명 .claude/, 개인키 .ssh/, 비번파일, .env, .bash_history, zip/백업,
#  spacer-mes·ai-doc-helper·lt-mes·bizcard-crm 등 별도 리포는 자동 제외)
/*

# --- shell / git dotfiles ---
!/.gitignore
# .bashrc 는 라이브 ANTHROPIC_API_KEY 평문 포함 → 추적 제외
!/.bash_profile
!/.bash_logout
!/.cshrc
!/.tcshrc
!/.gitconfig
!/.npmrc

# --- ops 스크립트 ---
!/README.md
!/npm-tunnel-on.sh
!/npm-tunnel-off.sh
!/cdp_pipe.js
!/shot_smoke.js
!/gen_careand_manual.py
!/gen_careand_pdf.py

# --- careand 운영/설계 문서 (대문자만 — 소문자 careand-계정비번.pdf 등은 제외 유지) ---
!/CAREAND-*
!/CareAnd-AI*

# --- caren 통합 디렉토리 (2026-07-30 이동) ---
# careand-admin-web/member-web/www/ai-service는 별도 git 리포이므로 계속 제외.
# doc/ 산출물도 위와 동일하게 CAREAND-*/CareAnd-AI*만 화이트리스트
# (DB백업 sql.gz, 계정비번/회원리스트 pdf, gitbak tgz, zip 등은 계속 제외 유지).
!/caren/
/caren/*
!/caren/doc/
/caren/doc/*
!/caren/doc/CAREAND-*
!/caren/doc/CareAnd-AI*

# caren/.claude/{agents,skills} — 플랫폼 공용 에이전트/스킬 정의(4개 레포가 상속). 순수 텍스트 md만 있음.
!/caren/.claude/
# 스킬 스크립트 실행 시 생기는 파이썬 바이트코드 캐시는 제외
/caren/.claude/**/__pycache__/

# --- 텔롬엑스 MES 온톨로지 설계서 (2026-09-19) ---
# HTML 이 원본이고 PDF 는 make_pdf.js 로 재생성되는 배포본이다.
# (제출·공유본이라 재생성 가능해도 함께 추적한다. 나머지 산출물·임시파일은 계속 제외)
!/telomx-mes-ontology/
/telomx-mes-ontology/*
!/telomx-mes-ontology/ONTOLOGY-DESIGN.html
!/telomx-mes-ontology/make_pdf.js
!/telomx-mes-ontology/TERM-MAP.html
!/telomx-mes-ontology/make_pdf_term.js
!/telomx-mes-ontology/pdf/
/telomx-mes-ontology/pdf/*
!/telomx-mes-ontology/pdf/*.pdf

# --- ops 스크립트 (/root/scripts) ---
# 평문 자격증명이 없는 것만 올린다(2026-09-20 전수 확인: 비밀번호는 전부 런타임에 .env 에서 읽는다).
# telom-x-dns-challenge/ 는 certbot 이 쓰는 작업 디렉터리라 제외 유지.
!/scripts/
/scripts/*
!/scripts/*.sh
