<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>AI 통합돌봄 서비스 Care& 시스템</title>
  <meta name="description" content="Care& AI 통합돌봄 서비스 — 관리자 콘솔과 회원 앱 통합 접속 포털" />
  <link rel="icon" href="/app/icons/icon-192.png" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link rel="stylesheet" as="style" crossorigin
        href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  <style>
    :root{
      --coral:#FF5A4D; --coral-d:#E8483C; --coral-soft:#FFE9E6;
      --ink:#1C2030; --ink-2:#5B6172; --ink-3:#9AA0AD;
      --line:#EFF1F4; --bg:#F6F7F9; --card:#FFFFFF;
    }
    *{box-sizing:border-box;}
    html,body{margin:0;padding:0;}
    body{
      font-family:"Pretendard Variable",Pretendard,-apple-system,BlinkMacSystemFont,
        "Apple SD Gothic Neo","Malgun Gothic","맑은 고딕",system-ui,Roboto,sans-serif;
      color:var(--ink);
      background:
        radial-gradient(1100px 520px at 12% -10%, var(--coral-soft) 0%, rgba(255,233,230,0) 60%),
        radial-gradient(900px 480px at 110% 0%, #EAF0FF 0%, rgba(234,240,255,0) 55%),
        var(--bg);
      min-height:100vh;
      -webkit-font-smoothing:antialiased;
    }
    .wrap{max-width:1120px;margin:0 auto;padding:40px 24px 56px;}
    header.hero{text-align:center;padding:32px 8px 26px;}
    .brand-chip{
      display:inline-flex;align-items:center;gap:8px;
      background:var(--card);border:1px solid var(--line);
      border-radius:999px;padding:7px 15px 7px 12px;
      font-weight:700;font-size:14px;color:var(--ink-2);
      box-shadow:0 2px 10px rgba(28,32,48,.05);
    }
    .brand-chip .dot{
      width:22px;height:22px;border-radius:7px;background:var(--coral);
      color:#fff;display:grid;place-items:center;font-style:italic;font-weight:800;font-size:13px;
      letter-spacing:-.5px;
    }
    h1.title{
      margin:20px 0 0;font-weight:800;letter-spacing:-1.2px;line-height:1.18;
      font-size:clamp(28px,5vw,52px);color:var(--ink);
    }
    h1.title .accent{color:var(--coral);font-style:italic;}
    p.sub{margin:14px auto 0;max-width:640px;color:var(--ink-2);font-size:clamp(14px,1.6vw,17px);font-weight:500;line-height:1.6;}

    .grid{
      display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:38px;
    }
    .panel{
      background:var(--card);border:1px solid var(--line);border-radius:22px;
      overflow:hidden;display:flex;flex-direction:column;
      box-shadow:0 12px 34px rgba(28,32,48,.07);
      min-height:560px;
    }
    .panel-head{
      display:flex;align-items:center;gap:13px;padding:18px 20px;border-bottom:1px solid var(--line);
      background:linear-gradient(180deg,#fff, #fff);
    }
    .panel-head .ico{
      width:42px;height:42px;border-radius:12px;display:grid;place-items:center;flex:0 0 auto;
      font-size:21px;
    }
    .panel.admin .ico{background:#EEF1FF;color:#3D5AFE;}
    .panel.member .ico{background:var(--coral-soft);color:var(--coral-d);}
    .panel-head .meta{flex:1;min-width:0;}
    .panel-head .meta .role{font-weight:800;font-size:17px;letter-spacing:-.4px;}
    .panel-head .meta .desc{font-size:12.5px;color:var(--ink-3);margin-top:2px;font-weight:500;}
    .panel-head .open{
      flex:0 0 auto;text-decoration:none;font-size:13px;font-weight:700;color:var(--ink-2);
      border:1px solid var(--line);border-radius:10px;padding:8px 12px;background:#fff;white-space:nowrap;
      transition:all .15s;
    }
    .panel-head .open:hover{border-color:var(--coral);color:var(--coral);}
    .frame-shell{position:relative;flex:1;background:var(--bg);}
    .frame-shell iframe{width:100%;height:100%;min-height:480px;border:0;display:block;}
    .frame-loading{
      position:absolute;inset:0;display:grid;place-items:center;gap:12px;
      color:var(--ink-3);font-size:13.5px;font-weight:600;pointer-events:none;
      transition:opacity .4s;
    }
    .spin{width:26px;height:26px;border-radius:50%;border:3px solid var(--line);
      border-top-color:var(--coral);animation:sp .8s linear infinite;}
    @keyframes sp{to{transform:rotate(360deg);}}

    footer.foot{margin-top:40px;text-align:center;color:var(--ink-3);font-size:12.5px;line-height:1.7;}
    footer.foot .sep{color:var(--line);margin:0 8px;}

    @media (max-width:820px){
      .grid{grid-template-columns:1fr;}
      .panel{min-height:520px;}
    }
  </style>
</head>
<body>
  <div class="wrap">
    <header class="hero">
      <span class="brand-chip"><span class="dot">C&amp;</span>AI 통합돌봄 플랫폼</span>
      <h1 class="title">AI 통합돌봄 서비스 <span class="accent">Care&amp;</span> 시스템</h1>
      <p class="sub">관리자 콘솔과 회원 앱을 한 곳에서. 아래에서 역할을 선택해 로그인하세요.</p>
    </header>

    <main class="grid">
      <!-- 관리자 -->
      <section class="panel admin">
        <div class="panel-head">
          <div class="ico">🛡️</div>
          <div class="meta">
            <div class="role">관리자 로그인</div>
            <div class="desc">운영 콘솔 · 매칭/정산/회원 관리</div>
          </div>
          <a class="open" href="/admin/login" target="_blank" rel="noopener">전체 화면 ↗</a>
        </div>
        <div class="frame-shell">
          <div class="frame-loading" id="load-admin"><div class="spin"></div>관리자 로그인 화면 불러오는 중…</div>
          <iframe id="frame-admin" src="/admin/login" title="관리자 로그인" loading="eager"></iframe>
        </div>
      </section>

      <!-- 회원 -->
      <section class="panel member">
        <div class="panel-head">
          <div class="ico">💗</div>
          <div class="meta">
            <div class="role">회원 로그인</div>
            <div class="desc">보호자 · 요양보호사(케어플로우) 앱</div>
          </div>
          <a class="open" href="/app/login" target="_blank" rel="noopener">전체 화면 ↗</a>
        </div>
        <div class="frame-shell">
          <div class="frame-loading" id="load-member"><div class="spin"></div>회원 로그인 화면 불러오는 중…</div>
          <iframe id="frame-member" src="/app/login" title="회원 로그인" loading="eager"></iframe>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div>Care&amp; · AI 통합돌봄 서비스 시스템</div>
      <div>관리자 콘솔 <span class="sep">|</span> 보호자·요양보호사 앱 <span class="sep">|</span> AI 매칭·돌봄 운영</div>
    </footer>
  </div>

  <script>
    // 로딩 인디케이터 숨김
    function hideLoader(id){ var el=document.getElementById(id); if(el){el.style.opacity='0';} }
    document.getElementById('frame-admin').addEventListener('load', function(){ hideLoader('load-admin'); });
    document.getElementById('frame-member').addEventListener('load', function(){ hideLoader('load-member'); });

    // 로그인 성공(=login 경로를 벗어남) 시 전체 화면으로 자동 전환 (동일 출처라 가능)
    function watch(frame, base){
      try{
        var w = frame.contentWindow;
        if(!w || !w.location) return;
        var href = w.location.href;
        var path = w.location.pathname;
        if(href && path.indexOf(base) === 0 && path.indexOf('/login') === -1){
          window.top.location.href = href; // 로그인 후 풀스크린 앱으로 이동
        }
      }catch(e){ /* 일시적 about:blank 등 무시 */ }
    }
    setInterval(function(){
      watch(document.getElementById('frame-admin'), '/admin');
      watch(document.getElementById('frame-member'), '/app');
    }, 900);
  </script>
</body>
</html>
